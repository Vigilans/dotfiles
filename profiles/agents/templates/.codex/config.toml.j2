{#- Codex rewrites config.toml at runtime (model/effort selections, marketplaces,
    plugin state, trusted projects), so patch the owned keys into the existing
    document and write the whole thing back instead of templating a fresh file.
    Tables are merged rather than replaced, for the same reason. -#}
{%- set config = toml.parse(fs.readFile(DOTFILES_HOME + "/.codex/config.toml") or fs.readFile(dst + "/.codex/config.toml") or "") %}

{#- Endpoint -#}
{%- set provider = AGENTS_MODEL_PROVIDER or "custom" %}
{%- if AGENTS_BASE_URL %}
{%-   set provider_config = {
      "name": AGENTS_MODEL_PROVIDER_DESCRIPTION or provider,
      "base_url": AGENTS_BASE_URL,
      "requires_openai_auth": AGENTS_CODEX_CHATGPT_LOGIN == "true",
      "wire_api": "responses"
    } %}
{%-   if AGENTS_API_KEY %}
{#-   auth.json holds one global credential, so a ChatGPT login would otherwise
      send its bearer token here. A provider-level token short-circuits that
      lookup and keeps model requests on this endpoint either way. -#}
{%-     set provider_config = json.merge(provider_config, "experimental_bearer_token", AGENTS_API_KEY) %}
{%-   endif %}
{%-   set config = toml.merge(config, "model_provider", provider) %}
{%-   set config = toml.merge(config, "model_providers", toml.merge(config.model_providers or {}, provider, provider_config)) %}
{%- endif %}
{%- set config = toml.merge(config, "model_catalog_json", "models.json") %}
{%- set config = toml.merge(config, "model_reasoning_summary", "detailed") %}
{%- set config = toml.merge(config, "web_search", "live") %}
{%- set config = toml.merge(config, "suppress_unstable_features_warning", true) %}

{#- Permissions -#}
{%- set config = toml.merge(config, "sandbox_mode", "danger-full-access") %}
{%- set config = toml.merge(config, "approval_policy", "on-request") %}
{%- set config = toml.merge(config, "approvals_reviewer", "auto_review") %}

{#- Plugins -#}
{%- set marketplaces = config.marketplaces or {} %}
{%- set marketplace = marketplaces["cc-marketplace"] or {} %}
{%- set marketplace = toml.merge(marketplace, "source_type", "git") %}
{%- set marketplace = toml.merge(marketplace, "source",
      "https://github.com/kenryu42/cc-marketplace.git") %}
{%- set config = toml.merge(config, "marketplaces",
      toml.merge(marketplaces, "cc-marketplace", marketplace)) %}

{%- set plugins = config.plugins or {} %}
{%- set plugin = plugins["cc-safety-net@cc-marketplace"] or {} %}
{%- set plugin = toml.merge(plugin, "enabled", true) %}
{%- set config = toml.merge(config, "plugins",
      toml.merge(plugins, "cc-safety-net@cc-marketplace", plugin)) %}

{#- Multi-agent -#}
{%- set config = toml.merge(config, "features", toml.merge(config.features or {},
      "multi_agent_v2", (AGENTS_CODEX_MULTI_AGENT_VERSION or "v2") == "v2")) %}

{#- Memories -#}
{%- set config = toml.merge(config, "features", toml.merge(config.features or {},
      "memories", true)) %}
{%- set config = toml.merge(config, "features", toml.merge(config.features or {},
      "external_agent_memory_import", true)) %}
{%- set config = toml.merge(config, "memories", toml.merge(config.memories or {},
      "use_memories", true)) %}
{%- set config = toml.merge(config, "memories", toml.merge(config.memories or {},
      "generate_memories", true)) %}
{%- set config = toml.merge(config, "analytics", toml.merge(config.analytics or {},
      "enabled", false)) %}

{#- Product surfaces -#}
{%- set config = toml.merge(config, "desktop", toml.merge(config.desktop or {},
      "enabled-reasoning-efforts", ["low", "medium", "high", "xhigh", "ultra", "max"])) %}
{%- set config = toml.merge(config, "desktop", toml.merge(config.desktop or {},
      "show-context-window-usage", true)) %}
{%- set config = toml.merge(config, "desktop", toml.merge(config.desktop or {},
      "conversationDetailMode", "STEPS_COMMANDS")) -%}

{{- toml.stringify(config) }}
