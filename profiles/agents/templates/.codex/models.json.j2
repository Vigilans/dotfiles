{#- Canonical model registry (AGENTS_<ALIAS>_MODEL) rendered as a Codex model
    catalog. Codex requires a full ModelInfo per entry — including the base
    instructions prompt — so every entry clones the prototype `package` exported
    from the installed binary, and only canonical fields are patched. -#}
{%- set prototype = fs.readFile(PROFILE_ROOT + "/build/codex-models.json") %}
{%- if not prototype %}
{%-   set _ = fail("missing build/codex-models.json — run the profile's package phase") %}
{%- endif %}
{%- set base = json.parse(prototype).models | selectattr("visibility", "equalto", "list") | first %}
{%- if not base %}
{%-   set _ = fail("no picker-visible model in the Codex catalog prototype") %}
{%- endif %}
{%- set reasoning_levels = [
      { "effort": "minimal", "description": "Fastest responses with minimal reasoning" },
      { "effort": "low", "description": "Fast responses with lighter reasoning" },
      { "effort": "medium", "description": "Balances speed and reasoning depth for everyday tasks" },
      { "effort": "high", "description": "Greater reasoning depth for complex problems" },
      { "effort": "xhigh", "description": "Extra high reasoning depth for complex problems" },
      { "effort": "max", "description": "Maximum reasoning depth for the hardest problems" }
    ] %}
{%- set efforts = [] %}
{%- for level in reasoning_levels %}
{%-   set _ = efforts.push(level.effort) %}
{%- endfor %}
{#- AGENTS_CODEX_ENABLED_MODELS defines both selection and order. Without it,
    Codex leads with the GPT aliases so the first picker-visible entry becomes
    the default on a fresh install. -#}
{%- set ordered = [] %}
{%- for alias in (AGENTS_CODEX_ENABLED_MODELS or "").split(",") %}
{%-   if alias.trim() %}
{%-     set _ = ordered.push(alias.trim().toUpperCase()) %}
{%-   endif %}
{%- endfor %}
{%- if not ordered.length %}
{%-   set ordered = ["GPT", "GPT_SOL", "GPT_TERRA", "GPT_LUNA", "FABLE", "OPUS", "SONNET", "HAIKU"] %}
{%-   set aliases = [] %}
{%-   for key, val in os.environ %}
{%-     if key.startsWith("AGENTS_") and key.endsWith("_MODEL") %}
{%-       set _ = aliases.push(key.slice(7, -6)) %}
{%-     endif %}
{%-   endfor %}
{%-   for alias in aliases | sort %}
{%-     if not ordered.includes(alias) %}
{%-       set _ = ordered.push(alias) %}
{%-     endif %}
{%-   endfor %}
{%- endif %}
{%- set multi_agent_version = AGENTS_CODEX_MULTI_AGENT_VERSION or "v2" %}
{%- if not ["v1", "v2"].includes(multi_agent_version) %}
{%-   set _ = fail("AGENTS_CODEX_MULTI_AGENT_VERSION must be v1 or v2") %}
{%- endif %}
{#- Appended to the prompts of models that cannot see. input_modalities stays
    image-capable so those models still accept pasted images. Every model here
    runs in code mode, where an agent role's own description reaches the model
    only if it goes looking for it, so the spawn protocol is spelled out in the
    prompt instead. -#}
{%- set vision_delegation %}
## Visual input delegation

You do not have visual understanding. Image content may be represented by the
text `image content omitted because you do not support image input`. Treat that
text as a signal that the original image is unavailable to you, not as a
description of the image.

When the answer depends on visual content, delegate its inspection to the
`vision` agent. Delegate instead of reconstructing the content yourself: do
not decode, render, sample, or otherwise analyze the file to substitute for
visual inspection.
{% if multi_agent_version == "v1" %}
Spawn it with `agent_type="vision"` and `fork_context=false`; a full-context
fork cannot select a different agent type. Pass the exact visual question and
every source explicitly through `items`:

`agent_type="vision", fork_context=false, items=[{"type":"text",
"text":"<exact visual question>"},{"type":"local_image",
"path":"<absolute image path>"}]`

Use a `local_image` item with `path` for a local or pasted image, an `image`
item with `image_url` for an image URL, and a `text` item for the question and
the source mapping. If no accessible path or URL is available, ask for the
image to be reattached or saved to an accessible path.

Wait for the result with `wait_agent` before answering. Ask follow-up
questions about the same sources with `send_input` on the same agent, calling
`resume_agent` first if it was closed, and pass a new source through
`send_input.items`.
{% else %}
Spawn it with `agent_type="vision"`, a short descriptive `task_name`, the
appropriate `fork_turns`, and a `message` holding the exact visual question
and every relevant source:

`agent_type="vision", task_name="inspect_image", fork_turns="1",
message="<exact visual question>"`

`task_name` only labels the child thread; naming it `vision` does not select
the role. Use `fork_turns="1"` for an image attached in the latest turn, the
smallest positive value that includes the image-bearing turn for an older
attachment, and `fork_turns="none"` when the source is reachable only through
a path or URL, naming that exact source in the message. An attachment's
displayed path does not make it path-only. If the required turn cannot be
identified, ask for the image to be reattached or for an accessible path.

Reuse the same vision agent for further questions about the same sources:
steer it with `send_message` while it runs, and start another turn with
`followup_task` once it is idle.
{% endif %}
Use the vision agent's report as visual evidence and perform the final
synthesis yourself. If visual delegation is unavailable or fails, state that
the visual content could not be inspected.
{% endset %}
{#- Aliases sharing one model collapse into a single catalog entry (Codex keys
    on slug = the model name sent to the API).
    The first alias in ordered priority wins the default reasoning effort. -#}
{%- set slugs = [] %}
{%- set collected = {} %}
{%- for alias in ordered %}
{%-   set model = os.environ["AGENTS_" + alias + "_MODEL"] %}
{%-   if model %}
{%-     set long_context = model.endsWith("[1m]") %}
{%-     set slug = model.slice(0, -4) if long_context else model %}
{%-     set description = os.environ["AGENTS_" + alias + "_MODEL_DESCRIPTION"] %}
{%-     set effort = os.environ["AGENTS_" + alias + "_REASONING_EFFORT"] %}
{%-     set vision = os.environ["AGENTS_" + alias + "_MODEL_VISION"] %}
{%-     if effort and not efforts.includes(effort) %}
{%-       set _ = fail("AGENTS_" + alias + "_REASONING_EFFORT must be one of " + efforts.join(", ")) %}
{%-     endif %}
{%-     set seen = collected[slug] %}
{%-     if seen %}
{%-       if seen.long_context != long_context %}
{%-         set _ = fail("aliases for " + slug + " disagree on the [1m] context annotation") %}
{%-       endif %}
{%-       if description and seen.description and description != seen.description %}
{%-         set _ = fail("aliases for " + slug + " disagree on the model description") %}
{%-       endif %}
{%-     else %}
{%-       set _ = slugs.push(slug) %}
{%-     endif %}
{%-     set collected = json.merge(collected, slug, {
          "long_context": long_context,
          "description": (seen.description if seen else "") or description,
          "effort": (seen.effort if seen else "") or effort,
          "vision": (seen.vision if seen else "") or vision
        }) %}
{%-   endif %}
{%- endfor %}
{%- set models = [] %}
{%- for slug in slugs %}
{%-   set entry = collected[slug] %}
{%-   set context_window = 1000000 if entry.long_context else 272000 %}
{%-   set model = base %}
{%-   set model = json.merge(model, "slug", slug) %}
{%-   set model = json.merge(model, "display_name", entry.description or slug) %}
{%-   set model = json.merge(model, "description", null) %}
{%-   set model = json.merge(model, "availability_nux", null) %}
{%-   set model = json.merge(model, "default_reasoning_level", entry.effort or "medium") %}
{%-   if slug.startsWith("kimi") or slug.startsWith("glm") or slug.startsWith("deepseek") %}
{%-     set model = json.merge(model, "supported_reasoning_levels",
          [reasoning_levels[1], reasoning_levels[3], reasoning_levels[5]]) %}{# 1/3/5 = low/high/max #}
{%-   elif slug.startsWith("qwen") %}
{%-     set model = json.merge(model, "supported_reasoning_levels",
          [reasoning_levels[1], reasoning_levels[2], reasoning_levels[4]]) %}{# 1/2/4 = low/medium/xhigh #}
{%-   elif slug.startsWith("gemini") %}
{%-     set model = json.merge(model, "supported_reasoning_levels",
          [reasoning_levels[1], reasoning_levels[2], reasoning_levels[3]]) %}{# 1/2/3 = low/medium/high #}
{%-   else %}
{%-     set model = json.merge(model, "supported_reasoning_levels", reasoning_levels) %}
{%-   endif %}
{%-   set model = json.merge(model, "context_window", context_window) %}
{%-   set model = json.merge(model, "max_context_window", context_window) %}
{%-   if entry.long_context and AGENTS_CODEX_AUTO_COMPACT_LIMIT_1M %}
{%-     set model = json.merge(model, "effective_context_window_percent", 100) %}
{%-     set model = json.merge(model, "auto_compact_token_limit", AGENTS_CODEX_AUTO_COMPACT_LIMIT_1M | int) %}
{%-   endif %}
{%-   set model = json.merge(model, "visibility", "list") %}
{%-   set model = json.merge(model, "supported_in_api", true) %}
{#-   Responses Lite is OpenAI's private wire variant: it moves `tools` and
      `instructions` into the input array, which leaves no top-level slot for
      server-executed tools, so Codex drops web_search and image_generation
      entirely. Third-party models need the standard Responses shape. -#}
{%-   set model = json.merge(model, "use_responses_lite", false) %}
{%-   set model = json.merge(model, "supports_parallel_tool_calls", true) %}
{%-   set model = json.merge(model, "supports_image_detail_original", false) %}
{%-   set model = json.merge(model, "service_tiers", []) %}
{%-   set model = json.merge(model, "additional_speed_tiers", []) %}
{%-   set model = json.merge(model, "priority", loop.index) %}
{%-   set model = json.merge(model, "multi_agent_version", multi_agent_version) %}
{%-   if entry.vision == "false" %}
{%-     set model = json.merge(model, "base_instructions",
          model.base_instructions + vision_delegation) %}
{%-     set model = json.merge(model, "model_messages", json.merge(model.model_messages,
          "instructions_template", model.model_messages.instructions_template + vision_delegation)) %}
{%-   endif %}
{%-   set _ = models.push(model) %}
{%- endfor -%}
{{ { "models": models } | dump(2) }}
