{#- Canonical model registry: AGENTS_<ALIAS>_MODEL, rendered as Claude Code's
    pinned alias env vars. FABLE/OPUS/SONNET/HAIKU lead, remaining aliases sort. -#}
{%- set aliases = [] %}
{%- for key, val in os.environ %}
{%-   if key.startsWith("AGENTS_") and key.endsWith("_MODEL") %}
{%-     set _ = aliases.push(key.slice(7, -6)) %}
{%-   endif %}
{%- endfor %}
{%- set ordered = ["FABLE", "OPUS", "SONNET", "HAIKU"] %}
{%- for alias in aliases | sort %}
{%-   if not ordered.includes(alias) %}
{%-     set _ = ordered.push(alias) %}
{%-   endif %}
{%- endfor -%}
{
  "env": {
    {%- if AGENTS_API_KEY %}
    {%-   if AGENTS_CLAUDE_SUBSCRIPTION_LOGIN == "true" and AGENTS_MODEL_PROVIDER == "litellm" %}
    "ANTHROPIC_CUSTOM_HEADERS": "x-litellm-api-key: {{ AGENTS_API_KEY }}",
    {%-   else %}
    "ANTHROPIC_AUTH_TOKEN": "{{ AGENTS_API_KEY }}",
    {%-   endif %}
    {%- endif %}
    {%- if AGENTS_BASE_URL %}
    "ANTHROPIC_BASE_URL": "{{ AGENTS_BASE_URL }}",
    {%- endif %}
    {%- if ANTHROPIC_MODEL %}
    "ANTHROPIC_MODEL": "{{ ANTHROPIC_MODEL }}",
    {%- endif %}
    {%- for alias in ordered %}
    {%-   set model = os.environ["AGENTS_" + alias + "_MODEL"] %}
    {%-   if model %}
    {%-     set effort = os.environ["AGENTS_" + alias + "_REASONING_EFFORT"] %}
    {%-     set description = os.environ["AGENTS_" + alias + "_MODEL_DESCRIPTION"] %}
    {#-     Gateways that select effort through the model name take the suffix
            ahead of the [1m] context annotation. -#}
    {%-     if AGENTS_MODEL_SUPPORTS_EFFORT_SUFFIX == "true" and effort %}
    {%-       if model.endsWith("[1m]") %}
    {%-         set model = model.slice(0, -4) + "-" + effort + "[1m]" %}
    {%-       else %}
    {%-         set model = model + "-" + effort %}
    {%-       endif %}
    {%-     endif %}
    "ANTHROPIC_DEFAULT_{{ alias }}_MODEL": "{{ model }}",
    {%-     if description %}
    "ANTHROPIC_DEFAULT_{{ alias }}_MODEL_DESCRIPTION": "{{ description }}",
    {%-     endif %}
    {%-   endif %}
    {%- endfor %}
    {%- if ANTHROPIC_SMALL_FAST_MODEL %}
    "ANTHROPIC_SMALL_FAST_MODEL": "{{ ANTHROPIC_SMALL_FAST_MODEL }}",
    {%- endif %}
    {%- if ANTHROPIC_CUSTOM_MODEL_OPTION %}
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "{{ ANTHROPIC_CUSTOM_MODEL_OPTION }}",
    {%- endif %}
    {%- for key, val in os.environ %}
    {%-   if key == "CLAUDE_CODE_SUBAGENT_MODE" or (key.startsWith("CLAUDE_CODE_SUBAGENT_") and key.endsWith("_MODEL")) %}
    "{{ key }}": "{{ val }}",
    {%-   endif %}
    {%- endfor %}
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "DISABLE_TELEMETRY": "1"
  },
  "includeCoAuthoredBy": false,
  {%- if ANTHROPIC_MODEL %}
  "model": "{{ ANTHROPIC_MODEL }}",
  {%- endif %}
  "effortLevel": "max",
  "cleanupPeriodDays": 90,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "enabledPlugins": {
    "osc-notify@vigilans-agents": true,
    "subagent-model@vigilans-agents": true,
    "agent-copilot@vigilans-agents": false,
    "safety-net@cc-marketplace": true
  },
  "extraKnownMarketplaces": {
    "cc-marketplace": {
      "source": {
        "source": "github",
        "repo": "kenryu42/cc-marketplace"
      }
    },
    "vigilans-agents": {
      "source": {
        "source": "directory",
        "path": "{{ HOME }}/.local/share/agents"
      }
    }
  },
  "hooks": {},
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "WebSearch",
      "WebFetch",

      "Bash(gh search:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh api:*)",
      "Bash(npm run:*)",
      "Bash(playwright-cli click:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git submodule status:*)",
      "Bash(git remote -v:*)",

      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(nl:*)",
      "Bash(jq:*)",
      "Bash(realpath:*)",
      "Bash(diff:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(tree:*)",
      "Bash(which:*)"
    ],
    "deny": [
      "Bash(git push:main)",
      "Bash(git push:master)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git add -A:*)",
      "Bash(git add:.:*)"
    ],
    "ask": [
      "Bash(git push:*)",

      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr review:*)",

      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",

      "Bash(gh repo create:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",

      "Bash(gh release create:*)",
      "Bash(gh release upload:*)",
      "Bash(gh release edit:*)",
      "Bash(gh release delete:*)",

      "Bash(gh api -X POST:*)",
      "Bash(gh api -X PUT:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api -X PATCH:*)",
      "Bash(gh api -XPOST:*)",
      "Bash(gh api -XPUT:*)",
      "Bash(gh api -XDELETE:*)",
      "Bash(gh api -XPATCH:*)",
      "Bash(gh api --method:*)",
      "Bash(gh api -f:*)",
      "Bash(gh api -F:*)"
    ]
  }
}
