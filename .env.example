# Comma-separated list of profiles to install via bootstrap.sh
# Use "*" to install all profiles compatible with the current OS
DOTFILES_PROFILES="*"

# Clone external profiles before install (name=url pairs, comma-separated)
# Names are auto-appended to DOTFILES_PROFILES
# DOTFILES_EXTRA_PROFILES="
#     secrets=git@github.com:you/dotfiles-secrets.git,
#     nvim=git@github.com:you/nvim-config.git
# "
